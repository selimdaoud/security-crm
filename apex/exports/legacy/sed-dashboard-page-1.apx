            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region sed-dashboard (
        name: SED Dashboard
        type: staticContent
        source {
            htmlCode: Security Advisor portfolio workflow to manage customers, related records, and operational follow-ups.
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
    )

)

