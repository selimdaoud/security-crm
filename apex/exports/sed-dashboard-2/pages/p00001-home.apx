    region security-events-card (
        name: Latest Security Publications
        title: Security Events
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select publication_id as event_row,
                
                       title,
                
                       case publication_type
                           when 'SECURITY_ALERT' then 'SECURITY ALERT'
                           else publication_type
                       end as type_label,
                
                       case publication_type
                           when 'SECURITY_ALERT' then 'alert'
                           when 'CSPU'           then 'cspu'
                           else                       'cpu'
                       end as type_class,
                
                       case
                           when alert_state in ('NEW', 'UPDATED')
                            and last_changed_at >= systimestamp - interval '1' day
                           then alert_state
                       end as state_label,
                
                       'Published ' ||
                       to_char(
                           published_on,
                           'DD Mon YYYY',
                           'NLS_DATE_LANGUAGE=English'
                       ) as published_label,
                
                       'fa-shield' as icon_class,
                
                       advisory_url
                
                  from security_publications
                
                 where published_on >= add_months(trunc(sysdate), -3)
                   and published_on < trunc(sysdate) + 1
                
                 order by published_on desc,
                          publication_id desc
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            columnSpan: 5
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: security-events-card
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--staticRowColors
                t-Report--rowHighlightOff
            ]
        }
        heading {
            type: none
        }

        column ADVISORY_URL (
            reportColumnQueryId: 8
            derivedColumn: N
            type: hidden
            layout {
                sequence: 80
            }
        )

        column EVENT_ROW (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="sed-security-event sed-security-event--#TYPE_CLASS#">
                      <div class="sed-security-event-icon">
                        <span class="fa #ICON_CLASS#" aria-hidden="true"></span>
                      </div>
                    
                      <div class="sed-security-event-content">
                        <a class="sed-security-event-title"
                           href="#ADVISORY_URL!ATTR#"
                           target="_blank"
                           rel="noopener noreferrer">
                          #TITLE#
                        </a>
                    
                        <div class="sed-security-event-date">
                          #PUBLISHED_LABEL#
                        </div>
                      </div>
                    
                      <div class="sed-security-event-badges">
                        <span class="sed-security-event-type">
                          #TYPE_LABEL#
                        </span>
                    
                        {if ?STATE_LABEL/}
                          <span class="sed-security-event-state sed-security-event-state--#STATE_LABEL#">
                            #STATE_LABEL#
                          </span>
                        {endif/}
                      </div>
                    </div>
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column ICON_CLASS (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 70
            }
        )

        column PUBLISHED_LABEL (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 60
            }
        )

        column STATE_LABEL (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 50
            }
        )

        column TITLE (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
        )

        column TYPE_CLASS (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 40
            }
        )

        column TYPE_LABEL (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 30
            }
        )

    )

    region sed-dashboard (
        name: SED Dashboard
        type: staticContent
        source {
            htmlCode: Security Advisor portfolio workflow to manage customers, related records, and operational follow-ups.
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
    )

    pageItem P1_ACTIVE_ACTIONS (
        type: switch
        label {
            label: Active Actions Only
            alignment: left
        }
        settings {
            useDefaults: false
            onValue: Y
            onLabel: Active actions only
            offValue: N
            offLabel: All
        }
        layout {
            sequence: 10
            region: @new_2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1_SECURITY_ADVISOR_USER_ID (
        type: selectList
        label {
            label: Security Advisor User Id
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value, return_value
                from (
                    select 0 as display_order,
                           'All Security Advisors' as display_value,
                           cast(null as number) as return_value
                    from dual
                
                    union all
                
                    select 1,
                           iu.full_name,
                           iu.user_id
                    from internal_users iu
                    where iu.active_flag = 'Y' and upper(trim(iu.role_name)) = 'SECURITY ADVISOR'
                
                
                )
                order by display_order, display_value
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 20
            region: @sed-dashboard
            slot: edit
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select iu.user_id
                from internal_users iu
                where lower(iu.email) = lower(:APP_USER)
                  and iu.active_flag = 'Y'
                  and upper(trim(iu.role_name)) = 'SECURITY ADVISOR'
                ```
        }
    )

    button 90d-kev (
        buttonName: 90D_KEV
        label: 90 Days Kev
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
