    )

    dynamicAction filter-portfolio-by-security-advisor (
        name: Filter Portfolio by Security Advisor
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P1_SECURITY_ADVISOR_USER_ID
        }

        action refresh (
            name: Refresh
            action: refresh
            affectedElements {
                selectionType: region
                region: @new_1
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction p1-action-filter (
        name: P1_ACTION_FILTER
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P1_ACTIVE_ACTIONS
        }

        action refresh (
            name: Refresh
            action: refresh
            affectedElements {
                selectionType: region
                region: @new_1
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-dashboard-after-dialog-save (
        name: Refresh Dashboard After Dialog Save
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: jQuerySelector
            jquerySelector: body
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @new_1
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-portfolio-after-customer-edit (
        name: Refresh Portfolio After Customer Edit
        execution {
