page 3 (
    name: Internal User
    alias: INTERNAL-USER
    title: Internal User
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region internal-user (
        name: Internal User
        type: form
        source {
            location: localDatabase
            tableName: INTERNAL_USERS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P3_ACTIVE_FLAG (
        type: textField
        label {
            label: Active Flag
            alignment: right
        }
        layout {
            sequence: 60
            region: @internal-user
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 1
        }
        source {
            formRegion: @internal-user
            column: ACTIVE_FLAG
            dataType: varchar2
        }
    )

    pageItem P3_CREATED_AT (
        type: datePicker
        label {
            label: Created At
            alignment: right
        }
        layout {
            sequence: 80
            region: @internal-user
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @internal-user
            column: CREATED_AT
            dataType: timestamp
        }
    )

    pageItem P3_CREATED_BY (
        type: hidden
        layout {
            sequence: 70
            region: @internal-user
            slot: regionBody
        }
        source {
            formRegion: @internal-user
            column: CREATED_BY
            dataType: varchar2
        }
    )

    pageItem P3_DEPARTMENT (
        type: textField
        label {
            label: Department
            alignment: right
        }
        layout {
            sequence: 50
            region: @internal-user
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @internal-user
            column: DEPARTMENT
            dataType: varchar2
        }
    )

    pageItem P3_EMAIL (
        type: textarea
        label {
            label: Email
            alignment: right
        }
        layout {
            sequence: 30
            region: @internal-user
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            valueRequired: true
            maxLength: 320
        }
        source {
            formRegion: @internal-user
            column: EMAIL
            dataType: varchar2
        }
    )

    pageItem P3_FULL_NAME (
        type: textField
        label {
            label: Full Name
            alignment: right
        }
        layout {
            sequence: 20
            region: @internal-user
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        source {
            formRegion: @internal-user
            column: FULL_NAME
            dataType: varchar2
        }
    )

    pageItem P3_ROLE_NAME (
        type: textField
        label {
            label: Role Name
            alignment: right
        }
        layout {
            sequence: 40
            region: @internal-user
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @internal-user
            column: ROLE_NAME
            dataType: varchar2
        }
    )

    pageItem P3_UPDATED_AT (
        type: datePicker
        label {
            label: Updated At
            alignment: right
        }
        layout {
            sequence: 100
            region: @internal-user
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @internal-user
            column: UPDATED_AT
            dataType: timestamp
        }
    )

    pageItem P3_UPDATED_BY (
        type: hidden
        layout {
            sequence: 90
            region: @internal-user
            slot: regionBody
        }
        source {
            formRegion: @internal-user
            column: UPDATED_BY
            dataType: varchar2
        }
    )

    pageItem P3_USER_ID (
        type: hidden
        layout {
            sequence: 10
            region: @internal-user
            slot: regionBody
        }
        source {
            formRegion: @internal-user
            column: USER_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P3_USER_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_USER_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_USER_ID
        }
    )

    validation p3-created-at-must-be-timestamp (
        name: P3_CREATED_AT must be timestamp
        execution {
            sequence: 70
        }
        validation {
            type: itemIsAValidTimestamp
            item: P3_CREATED_AT
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P3_CREATED_AT
        }
    )

    validation p3-updated-at-must-be-timestamp (
        name: P3_UPDATED_AT must be timestamp
        execution {
            sequence: 90
        }
        validation {
            type: itemIsAValidTimestamp
            item: P3_UPDATED_AT
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P3_UPDATED_AT
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 16948153908089067357
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-internal-user (
        name: Initialize form Internal User
        type: formInitialization
        formRegion: @internal-user
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 16948153156316067356
        }
    )

    process process-form-internal-user (
        name: Process form Internal User
        type: formAutoRowProcessing
        formRegion: @internal-user
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 16948153527794067357
        }
    )

)

