            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column LAST_SYNCED_AT (
            type: hidden
            heading {
                heading: Last Synced At
            }
            layout {
                sequence: 124
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: T
            }
        )

        column MANUAL_HEALTH_OVERRIDE_FLAG (
            type: plainText
