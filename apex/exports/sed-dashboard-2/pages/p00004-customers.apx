page 4 (
    name: Customers
    alias: CUSTOMERS
    title: Customers
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            <p>To find data enter a search term into the search dialog, or click on the column headings to limit the records returned.</p>
            
            <p>You can perform numerous functions by clicking the <strong>Actions</strong> button. This includes selecting the columns that are displayed / hidden and their display sequence, plus numerous data and format functions.  You can also define additional views of the data using the chart, group by, and pivot options.</p>
            
            <p>If you want to save your customizations select report, or click download to unload the data. Enter you email address and time frame under subscription to be sent the data on a regular basis.<p>
            
            <p>For additional information click Help at the bottom of the Actions menu.</p> 
            
            <p>Click the <strong>Reset</strong> button to reset the interactive report back to the default settings.</p>
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region customers (
        name: Customers
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select CUSTOMER_ID,
                       CUSTOMER_NAME,
                       INDUSTRY,
                       REGION, COUNTRY,
                       TIER_ID,
                       STATUS_ID,
                       PRIMARY_SECURITY_ADVISOR_USER_ID,
                       CURRENT_SECURITY_CONTACT_ID,
                       CURRENT_HEALTH_STATUS_ID,
                       CURRENT_HEALTH_SCORE,
                       HEALTH_SCORE_REASON,
                       HEALTH_CALCULATED_AT,
                       MANUAL_HEALTH_OVERRIDE_FLAG,
                       HEALTH_OVERRIDE_REASON,
                       HEALTH_OVERRIDE_BY,
                       HEALTH_OVERRIDE_AT,
                       NOTES,
                       SOURCE_SYSTEM,
                       SOURCE_REFERENCE,
                       LAST_SYNCED_AT,
                       CREATED_BY,
                       CREATED_AT,
                       UPDATED_BY,
                       UPDATED_AT,
                       ARR,
                       REGISTRYID
                  from CUSTOMERS
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 5
                items: {
                    P5_CUSTOMER_ID: \#CUSTOMER_ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 16948199371933068172
        }

        column ARR (
            type: plainText
            heading {
                heading: Arr
                alignment: end
            }
            layout {
                sequence: 234
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AE
            }
        )

        column COUNTRY (
            type: plainText
            heading {
                heading: Country
            }
            layout {
                sequence: 14
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AG
            }
        )

        column CREATED_AT (
            type: hidden
            heading {
                heading: Created At
            }
            layout {
                sequence: 144
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: V
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: Created By
            }
            layout {
                sequence: 134
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: U
            }
        )

        column CURRENT_HEALTH_SCORE (
            type: plainText
            heading {
                heading: Current Health Score
                alignment: end
            }
            layout {
                sequence: 34
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G999G999G999G990
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column CURRENT_HEALTH_STATUS_ID (
            type: plainText
            heading {
                heading: Current Health Status Id
                alignment: end
            }
            layout {
