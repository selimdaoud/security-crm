                sequence: 224
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AD
            }
        )

        column HEALTH_OVERRIDE_REASON (
            type: plainText
            heading {
                heading: Health Override Reason
