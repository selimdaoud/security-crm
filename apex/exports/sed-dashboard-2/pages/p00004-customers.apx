            }
            layout {
                sequence: 154
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: W
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CREATED_AT (
                sequence: 14
            )

            displayColumn CURRENT_HEALTH_SCORE (
                sequence: 4
            )

            displayColumn CUSTOMER_NAME (
                sequence: 1
            )

            displayColumn HEALTH_CALCULATED_AT (
                sequence: 6
            )

            displayColumn HEALTH_OVERRIDE_AT (
                sequence: 9
            )

            displayColumn HEALTH_OVERRIDE_REASON (
                sequence: 8
            )

            displayColumn HEALTH_SCORE_REASON (
                sequence: 5
            )

            displayColumn INDUSTRY (
                sequence: 2
            )

            displayColumn LAST_SYNCED_AT (
                sequence: 13
            )

            displayColumn MANUAL_HEALTH_OVERRIDE_FLAG (
                sequence: 7
            )

            displayColumn NOTES (
                sequence: 10
            )

            displayColumn REGION (
                sequence: 3
            )

            displayColumn SOURCE_REFERENCE (
                sequence: 12
            )

            displayColumn SOURCE_SYSTEM (
                sequence: 11
            )

            displayColumn UPDATED_AT (
                sequence: 15
            )

            sort (
                column: CUSTOMER_NAME
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @customers
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 5
                clearCache: 5
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @customers
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @customers
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

