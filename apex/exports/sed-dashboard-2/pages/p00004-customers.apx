            heading {
                heading: Notes
            }
            layout {
                sequence: 94
            }
            source {
                dataType: CLOB
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: Q
            }
            enableUsersTo {
                hide: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
            }
        )

        column PRIMARY_SECURITY_ADVISOR_USER_ID (
            type: plainText
            heading {
                heading: Primary Security Advisor User Id
                alignment: end
            }
            layout {
                sequence: 194
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AA
            }
        )

        column REGION (
            type: plainText
            heading {
                heading: Region
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column REGISTRYID (
            type: plainText
            heading {
