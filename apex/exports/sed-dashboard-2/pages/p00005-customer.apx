page 5 (
    name: Customer
    alias: CUSTOMER
    title: Customer
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region customer (
        name: Customer
        type: form
        source {
            location: localDatabase
            tableName: CUSTOMERS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P5_COUNTRY (
        type: textField
        label {
            label: Country
            alignment: left
        }
        layout {
            sequence: 50
            region: @customer
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 128
        }
        source {
            formRegion: @customer
            column: COUNTRY
            dataType: varchar2
        }
    )

    pageItem P5_CREATED_AT (
        type: hidden
        layout {
            sequence: 230
            region: @customer
            slot: regionBody
        }
        source {
            formRegion: @customer
            column: CREATED_AT
            dataType: timestamp
        }
    )

    pageItem P5_CREATED_BY (
        type: hidden
        layout {
            sequence: 220
            region: @customer
            slot: regionBody
        }
        source {
            formRegion: @customer
            column: CREATED_BY
            dataType: varchar2
        }
    )

    pageItem P5_CURRENT_HEALTH_SCORE (
        type: numberField
        label {
            label: Current Health Score
            alignment: left
        }
        layout {
            sequence: 110
            region: @customer
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @customer
            column: CURRENT_HEALTH_SCORE
            dataType: number
        }
    )

    pageItem P5_CURRENT_HEALTH_STATUS_ID (
        type: selectList
        label {
            label: Current Health Status
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @health-statuses-lookup-code
        }
        layout {
            sequence: 100
            region: @customer
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @customer
            column: CURRENT_HEALTH_STATUS_ID
            dataType: number
        }
    )

    pageItem P5_CURRENT_SECURITY_CONTACT_ID (
        type: selectList
        label {
            label: Current Security Contact
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select cc.full_name as display_value,
                       cc.contact_id as return_value
                  from customer_contacts cc
                 where cc.customer_id = :P5_CUSTOMER_ID
                   and cc.active_flag = 'Y'
                 order by cc.full_name
                ```
        }
        layout {
            sequence: 90
            region: @customer
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @customer
            column: CURRENT_SECURITY_CONTACT_ID
            dataType: number
        }
    )

    pageItem P5_CUSTOMER_ID (
        type: hidden
        layout {
            sequence: 10
            region: @customer
            slot: regionBody
        }
        source {
            formRegion: @customer
            column: CUSTOMER_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P5_CUSTOMER_NAME (
        type: textField
        label {
            label: Customer Name
            alignment: left
