            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 300
        }
        source {
            formRegion: @customer
            column: CUSTOMER_NAME
            dataType: varchar2
