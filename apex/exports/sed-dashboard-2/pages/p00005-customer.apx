    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P5_CUSTOMER_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P5_CUSTOMER_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P5_CUSTOMER_ID
        }
    )

    validation p5-created-at-must-be-timestamp (
        name: P5_CREATED_AT must be timestamp
        execution {
            sequence: 210
        }
        validation {
            type: itemIsAValidTimestamp
            item: P5_CREATED_AT
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P5_CREATED_AT
        }
    )

    validation p5-health-calculated-at-must-be-timestamp (
        name: P5_HEALTH_CALCULATED_AT must be timestamp
        execution {
            sequence: 110
        }
        validation {
            type: itemIsAValidTimestamp
            item: P5_HEALTH_CALCULATED_AT
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P5_HEALTH_CALCULATED_AT
        }
    )

    validation p5-health-override-at-must-be-timestamp (
        name: P5_HEALTH_OVERRIDE_AT must be timestamp
        execution {
            sequence: 150
        }
        validation {
            type: itemIsAValidTimestamp
            item: P5_HEALTH_OVERRIDE_AT
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P5_HEALTH_OVERRIDE_AT
        }
    )

    validation p5-last-synced-at-must-be-timestamp (
        name: P5_LAST_SYNCED_AT must be timestamp
        execution {
            sequence: 190
        }
        validation {
            type: itemIsAValidTimestamp
            item: P5_LAST_SYNCED_AT
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P5_LAST_SYNCED_AT
        }
    )

    validation p5-updated-at-must-be-timestamp (
        name: P5_UPDATED_AT must be timestamp
        execution {
            sequence: 230
        }
        validation {
            type: itemIsAValidTimestamp
            item: P5_UPDATED_AT
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P5_UPDATED_AT
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 16948198558201068171
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-customer (
        name: Initialize form Customer
        type: formInitialization
        formRegion: @customer
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 16948197742897068171
        }
    )

    process process-form-customer (
        name: Process form Customer
        type: formAutoRowProcessing
        formRegion: @customer
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 16948198170848068171
        }
    )

)
