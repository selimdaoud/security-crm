            type: sharedComponent
            lov: @team-roles-lookup-code
        }
        layout {
            sequence: 40
            region: @oracle-account-team-member
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
