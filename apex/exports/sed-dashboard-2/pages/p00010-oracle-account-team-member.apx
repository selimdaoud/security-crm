    pageItem P10_CUSTOMER_ID (
        type: selectList
        label {
            label: Customer
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @customers-customer-name
        }
        layout {
            sequence: 20
            region: @oracle-account-team-member
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @oracle-account-team-member
            column: CUSTOMER_ID
            dataType: number
        }
    )

    pageItem P10_END_DATE (
        type: datePicker
        label {
            label: End Date
