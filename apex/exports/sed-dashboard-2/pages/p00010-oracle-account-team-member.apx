page 10 (
    name: Oracle Account Team Member
    alias: ORACLE-ACCOUNT-TEAM-MEMBER
    title: Oracle Account Team Member
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region oracle-account-team-member (
        name: Oracle Account Team Member
        type: form
        source {
            location: localDatabase
            tableName: ORACLE_ACCOUNT_TEAM_MEMBERS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P10_ACCOUNT_TEAM_MEMBER_ID (
        type: hidden
        layout {
            sequence: 10
            region: @oracle-account-team-member
            slot: regionBody
        }
        source {
            formRegion: @oracle-account-team-member
            column: ACCOUNT_TEAM_MEMBER_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10_ACTIVE_FLAG (
        type: textField
        label {
            label: Active Flag
            alignment: right
        }
        layout {
            sequence: 80
            region: @oracle-account-team-member
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 1
        }
        source {
            formRegion: @oracle-account-team-member
            column: ACTIVE_FLAG
            dataType: varchar2
        }
    )

    pageItem P10_CREATED_AT (
        type: datePicker
        label {
            label: Created At
            alignment: right
        }
        layout {
            sequence: 100
            region: @oracle-account-team-member
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @oracle-account-team-member
            column: CREATED_AT
            dataType: timestamp
        }
    )

    pageItem P10_CREATED_BY (
        type: hidden
        layout {
            sequence: 90
            region: @oracle-account-team-member
            slot: regionBody
        }
        source {
            formRegion: @oracle-account-team-member
            column: CREATED_BY
            dataType: varchar2
        }
