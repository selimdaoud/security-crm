page 11 (
    name: Estate Items
    alias: ESTATE-ITEMS
    title: Estate Items
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            <p>To find data enter a search term into the search dialog, or click on the column headings to limit the records returned.</p>
            
            <p>You can perform numerous functions by clicking the <strong>Actions</strong> button. This includes selecting the columns that are displayed / hidden and their display sequence, plus numerous data and format functions.  You can also define additional views of the data using the chart, group by, and pivot options.</p>
            
            <p>If you want to save your customizations select report, or click download to unload the data. Enter you email address and time frame under subscription to be sent the data on a regular basis.<p>
            
            <p>For additional information click Help at the bottom of the Actions menu.</p> 
            
            <p>Click the <strong>Reset</strong> button to reset the interactive report back to the default settings.</p>
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region estate-items (
        name: Customer Estate Items
        type: interactiveReport
        source {
            location: localDatabase
            tableName: CUSTOMER_ESTATE_ITEMS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 12
                items: {
                    P12_ESTATE_ITEM_ID: \#ESTATE_ITEM_ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 16948298352864069619
        }

        column BUSINESS_CRITICALITY (
            type: plainText
            heading {
                heading: Business Criticality
            }
            layout {
                sequence: 9
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column CREATED_AT (
            type: plainText
            heading {
                heading: Created At
            }
            layout {
                sequence: 17
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: Q
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: Created By
            }
            layout {
                sequence: 16
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column CUSTOMER_ID (
            type: plainTextBasedOnLov
            heading {
                heading: Customer
            }
            lov {
                lov: @customers-customer-name
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column DEPLOYMENT_TYPE (
            type: plainText
            heading {
                heading: Deployment Type
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column ENVIRONMENT_NAME (
            type: plainText
            heading {
                heading: Environment Name
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column ESTATE_ITEM_ID (
            type: hidden
            heading {
                heading: Estate Item ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column ESTATE_TYPE_ID (
            type: plainTextBasedOnLov
            heading {
                heading: Estate Type
            }
            lov {
                lov: @estate-types-lookup-code
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column LAST_VERIFIED_AT (
            type: plainText
            heading {
                heading: Last Verified At
            }
            layout {
                sequence: 15
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: O
            }
        )

        column LIFECYCLE_STATUS_ID (
            type: plainTextBasedOnLov
            heading {
                heading: Lifecycle Status
            }
            lov {
                lov: @estate-lifecycle-statuses-lookup-code
            }
            layout {
                sequence: 11
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column NOTES (
            type: plainText
            heading {
                heading: Notes
            }
            layout {
                sequence: 12
            }
            source {
                dataType: CLOB
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: L
            }
            enableUsersTo {
                hide: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
            }
        )

        column PRODUCT_OR_SERVICE_NAME (
            type: plainText
            heading {
                heading: Product Or Service Name
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column PRODUCT_VERSION (
            type: plainText
            heading {
                heading: Product Version
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column REGION_NAME (
            type: plainText
            heading {
                heading: Region Name
            }
            layout {
                sequence: 8
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column SECURITY_RELEVANCE (
            type: plainText
            heading {
                heading: Security Relevance
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column SOURCE_REFERENCE (
            type: plainText
            heading {
                heading: Source Reference
            }
            layout {
                sequence: 14
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column SOURCE_SYSTEM (
            type: plainText
            heading {
                heading: Source System
            }
            layout {
                sequence: 13
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column UPDATED_AT (
            type: plainText
            heading {
                heading: Updated At
            }
            layout {
                sequence: 19
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: S
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Updated By
            }
            layout {
                sequence: 18
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: R
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BUSINESS_CRITICALITY (
                sequence: 8
            )

            displayColumn CREATED_AT (
                sequence: 15
            )

            displayColumn CUSTOMER_ID (
                sequence: 1
            )

            displayColumn DEPLOYMENT_TYPE (
                sequence: 5
            )

            displayColumn ENVIRONMENT_NAME (
                sequence: 6
            )

            displayColumn ESTATE_TYPE_ID (
                sequence: 2
            )

            displayColumn LAST_VERIFIED_AT (
                sequence: 14
            )

            displayColumn LIFECYCLE_STATUS_ID (
                sequence: 10
            )

            displayColumn NOTES (
                sequence: 11
            )

            displayColumn PRODUCT_OR_SERVICE_NAME (
                sequence: 3
            )

            displayColumn PRODUCT_VERSION (
                sequence: 4
            )

            displayColumn REGION_NAME (
                sequence: 7
            )

            displayColumn SECURITY_RELEVANCE (
                sequence: 9
            )

            displayColumn SOURCE_REFERENCE (
                sequence: 13
            )

            displayColumn SOURCE_SYSTEM (
                sequence: 12
            )

            displayColumn UPDATED_AT (
                sequence: 16
            )

            sort (
                column: CUSTOMER_ID
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @estate-items
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 12
                clearCache: 12
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @estate-items
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @estate-items
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

