    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P12_ESTATE_ITEM_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P12_ESTATE_ITEM_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P12_ESTATE_ITEM_ID
        }
    )

    validation p12-created-at-must-be-timestamp (
        name: P12_CREATED_AT must be timestamp
        execution {
            sequence: 160
        }
        validation {
            type: itemIsAValidTimestamp
            item: P12_CREATED_AT
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P12_CREATED_AT
        }
    )

    validation p12-last-verified-at-must-be-timestamp (
        name: P12_LAST_VERIFIED_AT must be timestamp
        execution {
            sequence: 140
        }
        validation {
            type: itemIsAValidTimestamp
            item: P12_LAST_VERIFIED_AT
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P12_LAST_VERIFIED_AT
        }
    )

    validation p12-updated-at-must-be-timestamp (
        name: P12_UPDATED_AT must be timestamp
        execution {
            sequence: 180
        }
        validation {
            type: itemIsAValidTimestamp
            item: P12_UPDATED_AT
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P12_UPDATED_AT
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 16948297584513069618
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-customer-estate-item (
        name: Initialize form Customer Estate Item
        type: formInitialization
        formRegion: @customer-estate-item
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 16948296748375069617
        }
    )

    process process-form-customer-estate-item (
        name: Process form Customer Estate Item
        type: formAutoRowProcessing
        formRegion: @customer-estate-item
