page 14 (
    name: Interaction
    alias: INTERACTION
    title: Interaction
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region interaction (
        name: Interaction
        type: form
        source {
            location: localDatabase
            tableName: INTERACTIONS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P14_CREATED_AT (
        type: datePicker
        label {
            label: Created At
            alignment: right
        }
        layout {
            sequence: 130
            region: @interaction
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @interaction
            column: CREATED_AT
            dataType: timestamp
        }
    )

    pageItem P14_CREATED_BY (
        type: hidden
        layout {
            sequence: 120
            region: @interaction
            slot: regionBody
        }
        source {
            formRegion: @interaction
            column: CREATED_BY
            dataType: varchar2
        }
    )

    pageItem P14_CUSTOMER_ID (
        type: selectList
        label {
            label: Customer
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @customers-customer-name
        }
        layout {
            sequence: 20
            region: @interaction
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @interaction
            column: CUSTOMER_ID
            dataType: number
        }
    )

    pageItem P14_EXTERNAL_CONTACT_ID (
        type: selectList
        label {
            label: External Contact
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @customer-contacts-full-name
        }
        layout {
            sequence: 80
            region: @interaction
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @interaction
            column: EXTERNAL_CONTACT_ID
            dataType: number
        }
    )

    pageItem P14_INTERACTION_DATE (
        type: datePicker
        label {
            label: Interaction Date
            alignment: right
        }
        layout {
            sequence: 40
            region: @interaction
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @interaction
            column: INTERACTION_DATE
            dataType: date
        }
    )

    pageItem P14_INTERACTION_ID (
        type: hidden
        layout {
            sequence: 10
            region: @interaction
            slot: regionBody
        }
        source {
            formRegion: @interaction
            column: INTERACTION_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P14_INTERACTION_TYPE_ID (
        type: selectList
        label {
            label: Interaction Type
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @interaction-types-lookup-code
        }
        layout {
            sequence: 30
            region: @interaction
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @interaction
            column: INTERACTION_TYPE_ID
            dataType: number
        }
    )

    pageItem P14_NEXT_STEPS (
        type: textarea
        label {
            label: Next Steps
            alignment: right
        }
        layout {
            sequence: 90
            region: @interaction
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        source {
            formRegion: @interaction
            column: NEXT_STEPS
            dataType: clob
        }
        sessionState {
            dataType: clob
        }
    )

    pageItem P14_OWNER_USER_ID (
        type: selectList
        label {
            label: Owner User
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @internal-users-full-name
        }
        layout {
            sequence: 70
            region: @interaction
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @interaction
            column: OWNER_USER_ID
            dataType: number
        }
    )

    pageItem P14_SOURCE_REFERENCE (
        type: textarea
        label {
            label: Source Reference
            alignment: right
        }
        layout {
            sequence: 110
            region: @interaction
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @interaction
            column: SOURCE_REFERENCE
            dataType: varchar2
        }
    )

    pageItem P14_SOURCE_SYSTEM (
        type: textField
        label {
            label: Source System
            alignment: right
        }
        layout {
            sequence: 100
            region: @interaction
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @interaction
            column: SOURCE_SYSTEM
            dataType: varchar2
        }
    )

    pageItem P14_SUBJECT (
        type: textarea
        label {
            label: Subject
            alignment: right
        }
        layout {
            sequence: 50
            region: @interaction
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            valueRequired: true
            maxLength: 300
        }
        source {
            formRegion: @interaction
            column: SUBJECT
            dataType: varchar2
        }
    )

    pageItem P14_SUMMARY (
        type: textarea
        label {
            label: Summary
            alignment: right
        }
        layout {
            sequence: 60
            region: @interaction
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        source {
            formRegion: @interaction
            column: SUMMARY
            dataType: clob
        }
        sessionState {
            dataType: clob
        }
    )

    pageItem P14_UPDATED_AT (
        type: datePicker
        label {
            label: Updated At
            alignment: right
        }
        layout {
            sequence: 150
            region: @interaction
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @interaction
            column: UPDATED_AT
            dataType: timestamp
        }
    )

    pageItem P14_UPDATED_BY (
        type: hidden
        layout {
            sequence: 140
            region: @interaction
            slot: regionBody
        }
        source {
            formRegion: @interaction
            column: UPDATED_BY
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P14_INTERACTION_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P14_INTERACTION_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P14_INTERACTION_ID
        }
    )

    validation p14-created-at-must-be-timestamp (
        name: P14_CREATED_AT must be timestamp
        execution {
            sequence: 120
        }
        validation {
            type: itemIsAValidTimestamp
            item: P14_CREATED_AT
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P14_CREATED_AT
        }
    )

    validation p14-updated-at-must-be-timestamp (
        name: P14_UPDATED_AT must be timestamp
        execution {
            sequence: 140
        }
        validation {
            type: itemIsAValidTimestamp
            item: P14_UPDATED_AT
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P14_UPDATED_AT
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 16948330327459070079
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-interaction (
        name: Initialize form Interaction
        type: formInitialization
        formRegion: @interaction
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 16948329518022070078
        }
    )

    process process-form-interaction (
        name: Process form Interaction
        type: formAutoRowProcessing
        formRegion: @interaction
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 16948329951420070079
        }
    )

)

