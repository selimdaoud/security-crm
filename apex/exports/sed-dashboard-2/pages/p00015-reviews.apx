page 15 (
    name: Reviews
    alias: REVIEWS
    title: Reviews
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            <p>To find data enter a search term into the search dialog, or click on the column headings to limit the records returned.</p>
            
            <p>You can perform numerous functions by clicking the <strong>Actions</strong> button. This includes selecting the columns that are displayed / hidden and their display sequence, plus numerous data and format functions.  You can also define additional views of the data using the chart, group by, and pivot options.</p>
            
            <p>If you want to save your customizations select report, or click download to unload the data. Enter you email address and time frame under subscription to be sent the data on a regular basis.<p>
            
            <p>For additional information click Help at the bottom of the Actions menu.</p> 
            
            <p>Click the <strong>Reset</strong> button to reset the interactive report back to the default settings.</p>
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region reviews (
        name: Reviews
        type: interactiveReport
        source {
            location: localDatabase
            tableName: REVIEWS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 16
                items: {
                    P16_REVIEW_ID: \#REVIEW_ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 16948361805168070574
        }

        column AGENDA (
            type: plainText
            heading {
                heading: Agenda
            }
            layout {
                sequence: 7
            }
            source {
                dataType: CLOB
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: G
            }
            enableUsersTo {
                hide: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
            }
        )

        column COMPLETED_AT (
            type: plainText
            heading {
                heading: Completed At
            }
            layout {
                sequence: 10
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: J
            }
        )

        column CREATED_AT (
            type: plainText
            heading {
                heading: Created At
            }
            layout {
                sequence: 12
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: L
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: Created By
            }
            layout {
                sequence: 11
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column CUSTOMER_ID (
            type: plainTextBasedOnLov
            heading {
                heading: Customer
            }
            lov {
                lov: @customers-customer-name
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column NOTES (
            type: plainText
            heading {
                heading: Notes
            }
            layout {
                sequence: 8
            }
            source {
                dataType: CLOB
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: H
            }
            enableUsersTo {
                hide: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
            }
        )

        column OUTCOME (
            type: plainText
            heading {
                heading: Outcome
            }
            layout {
                sequence: 9
            }
            source {
                dataType: CLOB
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: I
            }
            enableUsersTo {
                hide: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
            }
        )

        column OWNER_USER_ID (
            type: plainTextBasedOnLov
            heading {
                heading: Owner User
            }
            lov {
                lov: @internal-users-full-name
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column REVIEW_DATE (
            type: plainText
            heading {
                heading: Review Date
            }
            layout {
                sequence: 4
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: D
            }
        )

        column REVIEW_ID (
            type: hidden
            heading {
                heading: Review ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column REVIEW_TYPE (
            type: plainText
            heading {
                heading: Review Type
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column STATUS_ID (
            type: plainTextBasedOnLov
            heading {
                heading: Status
            }
            lov {
                lov: @review-statuses-lookup-code
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column UPDATED_AT (
            type: plainText
            heading {
                heading: Updated At
            }
            layout {
                sequence: 14
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: N
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Updated By
            }
            layout {
                sequence: 13
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AGENDA (
                sequence: 6
            )

            displayColumn COMPLETED_AT (
                sequence: 9
            )

            displayColumn CREATED_AT (
                sequence: 10
            )

            displayColumn CUSTOMER_ID (
                sequence: 1
            )

            displayColumn NOTES (
                sequence: 7
            )

            displayColumn OUTCOME (
                sequence: 8
            )

            displayColumn OWNER_USER_ID (
                sequence: 5
            )

            displayColumn REVIEW_DATE (
                sequence: 3
            )

            displayColumn REVIEW_TYPE (
                sequence: 2
            )

            displayColumn STATUS_ID (
                sequence: 4
            )

            displayColumn UPDATED_AT (
                sequence: 11
            )

            sort (
                column: CUSTOMER_ID
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @reviews
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 16
                clearCache: 16
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @reviews
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @reviews
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

