page 17 (
    name: Actions
    alias: ACTIONS
    title: Actions
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            <p>To find data enter a search term into the search dialog, or click on the column headings to limit the records returned.</p>
            
            <p>You can perform numerous functions by clicking the <strong>Actions</strong> button. This includes selecting the columns that are displayed / hidden and their display sequence, plus numerous data and format functions.  You can also define additional views of the data using the chart, group by, and pivot options.</p>
            
            <p>If you want to save your customizations select report, or click download to unload the data. Enter you email address and time frame under subscription to be sent the data on a regular basis.<p>
            
            <p>For additional information click Help at the bottom of the Actions menu.</p> 
            
            <p>Click the <strong>Reset</strong> button to reset the interactive report back to the default settings.</p>
            ```
    }

    region actions (
        name: Actions
        type: interactiveReport
        source {
            location: localDatabase
            tableName: ACTIONS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 18
                items: {
                    P18_ACTION_ID: \#ACTION_ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 16948395188467071069
        }

        column ACTION_ID (
            type: hidden
            heading {
                heading: Action ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column CAMPAIGN_RECIPIENT_ID (
            type: plainText
            heading {
                heading: Campaign Recipient ID
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column COMPLETED_AT (
            type: plainText
            heading {
                heading: Completed At
            }
            layout {
                sequence: 11
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: K
            }
        )

        column CREATED_AT (
            type: plainText
            heading {
                heading: Created At
            }
            layout {
                sequence: 14
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: N
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: Created By
            }
            layout {
                sequence: 13
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column CUSTOMER_ID (
            type: plainTextBasedOnLov
            heading {
                heading: Customer
            }
            lov {
                lov: @customers-customer-name
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column DESCRIPTION (
            type: plainText
            heading {
                heading: Description
            }
            layout {
                sequence: 6
            }
            source {
                dataType: CLOB
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: F
            }
            enableUsersTo {
                hide: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
            }
        )

        column DUE_DATE (
            type: plainText
            heading {
                heading: Due Date
            }
            layout {
                sequence: 10
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: J
            }
        )

        column OWNER_USER_ID (
            type: plainTextBasedOnLov
            heading {
                heading: Owner User
            }
            lov {
                lov: @internal-users-full-name
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column PRIORITY_ID (
            type: plainTextBasedOnLov
            heading {
                heading: Priority
            }
            lov {
                lov: @action-priorities-lookup-code
            }
            layout {
                sequence: 8
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column RESOLUTION_NOTES (
            type: plainText
            heading {
                heading: Resolution Notes
            }
            layout {
                sequence: 12
            }
            source {
                dataType: CLOB
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: L
            }
            enableUsersTo {
                hide: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
            }
        )

        column SECURITY_CASE_ID (
            type: plainText
            heading {
                heading: Security Case ID
                alignment: end
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column STATUS_ID (
            type: plainTextBasedOnLov
            heading {
                heading: Status
            }
            lov {
                lov: @action-statuses-lookup-code
            }
            layout {
                sequence: 9
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column TITLE (
            type: plainText
            heading {
                heading: Title
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column UPDATED_AT (
            type: plainText
            heading {
                heading: Updated At
            }
            layout {
                sequence: 16
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: P
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Updated By
            }
            layout {
                sequence: 15
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COMPLETED_AT (
                sequence: 8
            )

            displayColumn CREATED_AT (
                sequence: 10
            )

            displayColumn CUSTOMER_ID (
                sequence: 1
            )

            displayColumn DESCRIPTION (
                sequence: 3
            )

            displayColumn DUE_DATE (
                sequence: 7
            )

            displayColumn OWNER_USER_ID (
                sequence: 4
            )

            displayColumn PRIORITY_ID (
                sequence: 5
            )

            displayColumn RESOLUTION_NOTES (
                sequence: 9
            )

            displayColumn STATUS_ID (
                sequence: 6
            )

            displayColumn TITLE (
                sequence: 2
            )

            displayColumn UPDATED_AT (
                sequence: 11
            )

            sort (
                column: CUSTOMER_ID
                sort {
                    sequence: 1
                }
            )

        )

    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @actions
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 18
                clearCache: 18
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @actions
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @actions
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

