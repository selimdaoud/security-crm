    region contacts (
        name: Contacts
        title: Contacts
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    contact_id,
                    full_name,
                    job_title,
                    role_type,
                    email,
                    phone,
                    is_primary,
                    is_current_security_contact,
                    active_flag
                from customer_contacts
                where customer_id = :P21_CUSTOMER_ID
                order by is_primary desc, full_name
                ```
