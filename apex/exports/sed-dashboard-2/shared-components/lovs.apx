lov security-advisors-full-name (
    name: SECURITY_ADVISORS.FULL_NAME
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select full_name d,
                   user_id   r
              from internal_users
             where active_flag = 'Y'
               and upper(trim(role_name)) = 'SECURITY ADVISOR'
             order by full_name
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

